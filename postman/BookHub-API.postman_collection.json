{
  "info": {
    "name": "BookHub API",
    "description": "API da biblioteca BookHub (aula DevHub), multi-tenant.\n\n1. Rode um Login: o token é salvo sozinho na variável {{token}}.\n2. Se a resposta trouxer precisaEscolherEmpresa: true, rode Auth > Escolher empresa (o token é trocado sozinho).\n3. As rotas protegidas já enviam o header Authorization: Bearer {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (leitor, 1 empresa)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Ana só participa de uma empresa: o token já vem com ela.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@bookhub.com\",\n  \"senha\": \"leitor123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Salva o token retornado na variável {{token}} da collection",
                  "const dados = pm.response.json();",
                  "if (pm.response.code === 200 && dados.token) {",
                  "  pm.collectionVariables.set(\"token\", dados.token);",
                  "  if (dados.precisaEscolherEmpresa) {",
                  "    console.log(\"Usuário com várias empresas: rode 'Escolher empresa'. Opções:\", dados.empresas);",
                  "  }",
                  "}",
                  "pm.test(\"Retorna 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin, várias empresas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Admin participa de duas empresas: depois rode 'Escolher empresa'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bookhub.com\",\n  \"senha\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Salva o token retornado na variável {{token}} da collection",
                  "const dados = pm.response.json();",
                  "if (pm.response.code === 200 && dados.token) {",
                  "  pm.collectionVariables.set(\"token\", dados.token);",
                  "  if (dados.precisaEscolherEmpresa) {",
                  "    console.log(\"Usuário com várias empresas: rode 'Escolher empresa'. Opções:\", dados.empresas);",
                  "  }",
                  "}",
                  "pm.test(\"Retorna 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Escolher empresa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/empresa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "empresa"
              ]
            },
            "description": "Escolhe ou troca a empresa. Devolve um token novo para ela.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empresaId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Salva o token retornado na variável {{token}} da collection",
                  "const dados = pm.response.json();",
                  "if (pm.response.code === 200 && dados.token) {",
                  "  pm.collectionVariables.set(\"token\", dados.token);",
                  "  if (dados.precisaEscolherEmpresa) {",
                  "    console.log(\"Usuário com várias empresas: rode 'Escolher empresa'. Opções:\", dados.empresas);",
                  "  }",
                  "}",
                  "pm.test(\"Retorna 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
