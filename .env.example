# Servidor
PORT=3000
NODE_ENV=development

# MySQL
# - Docker local (docker compose up -d): DB_HOST=localhost, DB_USER=bookhub, DB_PASSWORD=bookhub123
# - EasyPanel: preencha com as credenciais do serviço (veja o README)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bookhub

# Autenticação
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
